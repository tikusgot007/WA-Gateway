# =============================================================
# Kontrak CI4 (AuliaPos) -- Bearer token, sama persis dengan
# app/Config/Inbox.php (env inbox.gatewayToken) di sisi AuliaPos.
# =============================================================
CI4_BASE_URL=http://192.168.x.x/aulia-app
CI4_GATEWAY_TOKEN=
CI4_REQUEST_TIMEOUT_MS=8000

# =============================================================
# Evolution API (self-hosted, Docker di PC gateway)
# =============================================================
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=aulia-uji
EVOLUTION_REQUEST_TIMEOUT_MS=15000

# Path relatif yang dimount server ini untuk menerima webhook Evolution.
# Daftarkan ke Evolution: POST /webhook/set/{instance} dengan
# url = http://<ip-pc-gateway>:<PORT><EVOLUTION_WEBHOOK_PATH>
EVOLUTION_WEBHOOK_PATH=/evolution/webhook

# Opsional: shared secret webhook (dikirim Evolution via header custom
# yang diatur di /webhook/set `headers`). Kosong = tanpa validasi secret
# (andalkan isolasi LAN).
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_SECRET_HEADER=x-adapter-webhook-secret

# Status koneksi eksplisit dianggap basi setelah sekian ms tanpa update.
EVOLUTION_CONNECTION_STALE_MS=120000

# =============================================================
# Server HTTP adapter
# =============================================================
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
LOG_FOLDER=

# =============================================================
# Durabilitas (reuse mesin WA-Gateway)
# =============================================================
SQLITE_PATH=./data/evolution-gateway.sqlite
DELIVERY_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=15000
MAX_MEDIA_UPLOAD_MB=20

# =============================================================
# Media MASUK (Tahap 4) -- lihat README §Media & retensi
# =============================================================
EVOLUTION_MEDIA_MODE=base64
MEDIA_STORE_DIR=./data/media
MEDIA_RETENTION_DAYS=7

# TTL store kutipan (balas/quote), default 7 hari.
QUOTED_STORE_TTL_MS=604800000

# Cache info grup (subject + pemetaan LID->nomor), default 10 menit.
GROUP_INFO_CACHE_TTL_MS=600000
