# =============================================================
# WA Gateway POC - Konfigurasi
# Copy file ini menjadi ".env" lalu sesuaikan nilainya.
# =============================================================

# Host & Port HTTP API + Dashboard
# Default: hanya bisa diakses dari komputer ini sendiri (aman untuk POC awal)
HOST=127.0.0.1
PORT=3000

# Ubah HOST=0.0.0.0 jika ingin gateway bisa diakses dari komputer lain di LAN toko.
# PERINGATAN: API POC ini TIDAK memiliki authentication.
# Jika HOST=0.0.0.0, siapapun yang terhubung ke LAN yang sama bisa:
#   - membaca pesan masuk melalui GET /api/messages
#   - mengirim pesan WhatsApp atas nama nomor yang login melalui POST /api/messages/send
#   - melakukan logout/reset session melalui POST /api/logout
# Jangan expose ke internet. Gunakan hanya di LAN toko yang dipercaya.
# Sebelum menjadi production, tambahkan authentication (API key/JWT) pada API ini.

# Folder tempat menyimpan session/credential WhatsApp (akan dibuat otomatis jika belum ada)
AUTH_FOLDER=./auth

# Level log: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Folder tempat menyimpan file log (opsional, boleh dikosongkan untuk console-only)
LOG_FOLDER=./logs

# Jumlah maksimal pesan masuk yang disimpan di memory untuk ditampilkan di dashboard
MAX_MESSAGES_IN_MEMORY=200

# Konfigurasi reconnect backoff (dalam milidetik)
RECONNECT_INITIAL_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
RECONNECT_BACKOFF_FACTOR=2

# =============================================================
# Phase 2 - Integrasi ke AuliaPos CI4 (Shared WhatsApp Inbox)
# =============================================================

# Base URL AuliaPos CI4, TANPA trailing slash. Contoh:
#   CI4_BASE_URL=http://192.168.1.10/aulia
CI4_BASE_URL=

# Shared secret Bearer token -- HARUS SAMA PERSIS dengan nilai
# `inbox.gatewayToken` di file .env milik AuliaPos CI4.
# Gunakan string acak yang panjang & sulit ditebak, JANGAN commit
# nilai sungguhan ke source control.
CI4_GATEWAY_TOKEN=

# Timeout per request HTTP ke CI4 (ms)
CI4_REQUEST_TIMEOUT_MS=8000

# Path file database SQLite (reliability buffer pesan masuk).
# Folder akan dibuat otomatis jika belum ada.
SQLITE_PATH=./data/gateway.sqlite

# Seberapa sering worker mencoba mengirim ulang event pending ke CI4 (ms)
DELIVERY_INTERVAL_MS=5000

# Backoff retry PER EVENT yang gagal terkirim ke CI4 (ms)
DELIVERY_RETRY_INITIAL_DELAY_MS=3000
DELIVERY_RETRY_MAX_DELAY_MS=120000
DELIVERY_RETRY_BACKOFF_FACTOR=2

# Seberapa sering Gateway push status koneksi ke CI4 (ms) -- spec
# merekomendasikan ~15 detik.
HEARTBEAT_INTERVAL_MS=15000
